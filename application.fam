# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="crash_cart",  # Must be unique
    name="Crash Cart",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="crash_cart_app",
    stack_size=2 * 1024,
    fap_category="USB",
    # Optional values
    fap_version="1.0",
    fap_icon="crash_cart.png",  # 10x10 1-bit PNG
    fap_description="A customizable USB keyboard remote with switchable profiles (a USB port of Anki Remote)",
    fap_author="cwoodcox, Blue5GD",
    fap_weburl="https://github.com/cwoodcox/flipper-crash-cart",
    fap_icon_assets="images",  # Image assets to compile for this application
)
